#!/bin/bash

# use os
# use os_windows

set -o allexport

MSYS_NO_PATHCONV=1 subst /d a: | true && subst a: .

history -c
HISTFILE=/a/null/.bash_history

path /a/user

[[ -z $user_name ]] && [[ -f /a/user/profile/$user_name      ]] && source /a/user/profile/$user_name
[[ -z $user_name ]] && [[ -d /a/user/profile/$user_name      ]] && path   /a/user/profile/$user_name
[[ -z $user_name ]] && [[ -f /a/user/profile/$user_name/init ]] && source /a/user/profile/$user_name/init

return 0
