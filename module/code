#!/bin/bash

set -o allexport

use

use git
use hub

function get_slug {
	slug=$1
	user=$( echo $slug | cut -d'/' -f1 )
	repo=$( echo $slug | cut -d'/' -f2 )
	[[ $slug == */* ]] || user=$user_name
	slug="$user/$repo"
	echo "slug: $slug"
}

function code_list {
	# local -; set -o errexit

	name="${1:-$GITHUB_USER}"

	[[ -d ~/desktop/code/$name ]] || err

	[[ $* == *--all* ]] && {
		pass
	}

	# ls -1 --almost-all ~/desktop/code/$name

	# cd ~/desktop/code/$name
	# find . -mindepth 1 -maxdepth 1 -type d | sed "s|\./|$name/|g"

	cd ~/desktop/code
	find . -mindepth 2 -maxdepth 2 -type d | sed "s|\./||g"
}

function code_list_all {
	# local -; set -o errexit

	name="${1:-$user_name}"
	code_list $name

	# todo
}

function code_save {
	git diff --cached --quiet && git add --all
	git_commit_empty
}
