#!/bin/bash

test() {
	echo testing $1
	pushd file/$1 > /dev/null

	MSYS_NO_PATHCONV=1 subst /d a: | true && subst a: .

	[[ -f "user/clean"   ]] && user/clean
#	[[ -f "user/install" ]] && user/install
	[[ -f "user/build"   ]] && user/build
	[[ -f "user/run"     ]] && user/run

	popd > /dev/null
}

test $@
