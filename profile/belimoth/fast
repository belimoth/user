#!/bin/bash

function fast_init_load {
	[[ -f ~/desktop/void/user/init ]] || return 1
	set -o allexport
	source ~/desktop/void/user/init
	set +o allexport
	echo fast
	return 0
}

fast_init_load && return 0

function fast_init_save {
	md --parents ~/desktop/void/user
	[[ -f ~/desktop/void/user/init ]] && rm ~/desktop/void/user/init
	touch ~/desktop/void/user/init
	shopt -op >> ~/desktop/void/user/init
	# env >> ~/desktop/void/user/init
	export -p | grep -Ev '^(declare -xr|export) (BASH|_=|PWD|OLDPWD|SHELLOPTS|SHLVL|UID|PPID)' >> ~/desktop/void/user/init
	# declare -p | grep -Ev '^(declare -xr|export) (BASH|_=|PWD|OLDPWD|SHELLOPTS|SHLVL|UID|PPID)' >> ~/desktop/void/user/init
	declare -f | grep -Ev '^(declare -xr|export) (BASH|_=|PWD|OLDPWD|SHELLOPTS|SHLVL|UID|PPID)' >> ~/desktop/void/user/init
}

function fast_init_thaw {
	rm ~/desktop/void/user/init
}
