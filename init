#!/bin/bash

[[ "${BASH_SOURCE[0]}" == "${0}" ]] && err "usage: source $user_path/init"

set -o allexport

alias md="mkdir --parents"
alias skip=":"
alias and="&&"
alias or="||"
alias then="{"
alias end="}"

bind "set bell-style $user_bell"

skip ${user_name:=$( whoami )}
skip ${user_path:=~/desktop}

# stem=bzz
# declare prefix_$stem_suffix_=mystr
# varname=prefix_${stem}_suffix
# echo $varname
# echo ${!varname}

function var {
	# declare todo
	skip
}

var user_name $( whoami )
var user_path ~/desktop

MSYS=winsymlinks:nativestrict

PWD=$( cygpath --unix $( pwd ) )
PWD=${PWD/#$HOME/\~}

function path {
	export PATH=$1:$PATH
}

path $user_path/user/profile/$user_name
path $user_path/user

function err {
	echo error: $@
	return 1
}

function has {
	command -v $1 &> /dev/null || err
}

function use {
	function stub { eval "function use_$1 { skip; }"; }

	local -; set -o allexport

	[[ -d ~/desktop/user/package/$1 ]] && path ~/desktop/user/package/$1

	[[ $( type -t use_$1 ) == function ]] && {
		eval "use_$1"
		stub $1
		return 0
	}

	[[ -f ~/desktop/user/module/$1 ]] && {
		source ~/desktop/user/module/$1
		stub $1
		return 0
	}

	err use $1
}

use os

function init {
	skip
}

alias init=":"
